FROM ghcr.io/astral-sh/uv:0.8.8 AS uv
FROM python:3.12-slim
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY cwm_minio_api ./cwm_minio_api
RUN uv sync --frozen --no-dev --extra load-test && useradd --uid 10001 --create-home campaign
ENV PATH="/app/.venv/bin:$PATH"
USER 10001
ENTRYPOINT ["python", "-m", "cwm_minio_api.load_tests.campaign"]
